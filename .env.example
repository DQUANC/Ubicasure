# Backend (back/.env)
PORT=3200
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
JWT_SECRET=change-this-to-a-long-random-string
ADMIN_PASSWORD=change-this-default-password
# Production frontend URL for CORS — set to your Firebase Hosting or Railway frontend URL
FRONTEND_URL=https://your-app.web.app

# Frontend (front/.env.local for dev, front/.env.production for prod)
NEXT_PUBLIC_API_URL=http://localhost:3200
NEXT_PUBLIC_MAPS_API_KEY=your-google-maps-api-key
